# Source this file on Linux after supplying values. It is never loaded automatically.
# Direct OpenAI-compatible backend (NVIDIA NIM, vLLM, or another compatible service).
SIM_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
SIM_LLM_MODEL=replace-with-an-available-model-id
SIM_LLM_API_KEY=replace-me
SIM_LLM_TIMEOUT=90
# Approximate USD per million tokens; set for your endpoint. Unknown cost stays null.
SIM_INPUT_USD_PER_MILLION=
SIM_OUTPUT_USD_PER_MILLION=
# NOOA backend uses an alias configured by `nooa connect`.
SIM_NOOA_MODEL=service-desk
NEMO_TELEMETRY_ENABLED=false

