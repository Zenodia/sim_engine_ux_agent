# Automatically loaded from .env in the current working directory.
# Exported shell variables take precedence. Never commit your real .env file.
# NVIDIA inference gateway, called through the OpenAI Python SDK.
SIM_LLM_BASE_URL=https://inference-api.nvidia.com/v1
SIM_LLM_MODEL=aws/anthropic/bedrock-claude-sonnet-5
SIM_LLM_API_KEY=replace-me
SIM_LLM_TIMEOUT=90
SIM_LLM_MAX_TOKENS=512
# Sonnet can spend output tokens on reasoning; give agent actions enough headroom.
SIM_CANDIDATE_LLM_MAX_TOKENS=2048
# text omits response_format from the request; the prompt still requests JSON actions.
# Set json_object only for endpoints/models known to support that request option.
SIM_LLM_RESPONSE_FORMAT=text
# Optional: omit temperature unless supported by the selected endpoint/model.
# SIM_LLM_TEMPERATURE=0
# SDG is independent from the agent-under-test model and uses the same key by default.
SIM_SDG_LLM_BASE_URL=https://inference-api.nvidia.com/v1
SIM_SDG_LLM_MODEL=nvidia/nvidia/nemotron-3-super-rc-nim
SIM_SDG_LLM_TEMPERATURE=0.7
SIM_SDG_LLM_MAX_TOKENS=1024
SIM_SDG_LLM_RESPONSE_FORMAT=text
# Short SDG batches do not need reasoning to consume the output budget.
SIM_SDG_LLM_ENABLE_THINKING=false
# Optional separate SDG key: SIM_SDG_LLM_API_KEY=replace-me
# Pricing per million TOKENS (not users or requests); optional accounting only.
# The toy demo uses 100 users. Unknown cost stays null.
SIM_INPUT_USD_PER_MILLION=
SIM_OUTPUT_USD_PER_MILLION=
# NOOA backend uses an alias configured by `nooa connect`.
SIM_NOOA_MODEL=service-desk
NEMO_TELEMETRY_ENABLED=false

# Dedicated self-hosted n8n fixture lab (separate from the NVIDIA inference key).
N8N_LAB_URL=http://127.0.0.1:5680
N8N_LAB_API_KEY=
N8N_LAB_FIXTURE_URL=http://127.0.0.1:8091
N8N_LAB_FIXTURE_INTERNAL_URL=http://fixtures:8091
N8N_LAB_PUBLISH_ACTION=publish
# Required only when serving the draft gateway: generate a random local token.
N8N_LAB_GATEWAY_TOKEN=

